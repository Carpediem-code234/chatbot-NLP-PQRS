# Copia este archivo como .env y completa los valores. NUNCA subas el .env a git.

# ── WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → Configuración de la API) ──
WA_TOKEN=pega_aqui_el_token_de_acceso            # token del usuario del sistema (permanente); el temporal dura ~24 h
PHONE_NUMBER_ID=123456789012345                  # "Identificador del número de teléfono" (no es el número)
VERIFY_TOKEN=una_frase_secreta_que_tu_inventas   # la misma que escribes en Meta al configurar el webhook
APP_SECRET=pega_aqui_la_clave_secreta_de_la_app  # Configuración de la app → Básica → Clave secreta (verifica la firma)
GRAPH_VERSION=v23.0

# ── Servicio ──
ADMIN_TOKEN=otra_frase_secreta_para_el_panel     # protege /api/pqrs (cabecera X-Admin-Token)
DB_PATH=data/pqrs.db
MINUTOS_SESION=30
